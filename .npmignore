# With a `files` field in package.json, npm uses inclusion-only semantics
# and ignores most of this list. We keep .npmignore as a safety net in case
# `files` is ever loosened and to make the publish surface explicit.

# Developer-only directories
.claude/
.claude-plugin/
.github/
.git/
scripts/
sandbox/
outputs/
dist/
deno_dir/
node_modules/

# Config + meta that npm consumers don't need
CLAUDE.md
release-please-config.json
.release-please-manifest.json
.gitignore
.gitattributes

# Reference scripts and node_modules bundled inside the hub — npm consumers
# of @borgiq/skills don't run TypeScript validators (they invoke the borgiq
# CLI directly). The validators stay accessible via git clone.
plugins/borgiq-builder/skills/borgiq-builder/scripts/
plugins/borgiq-builder/skills/borgiq-builder/references/cli/scripts/

# Test/build artifacts
*.skill
*.tgz
__pycache__/
*.pyc
